# ===== Django =====
DEBUG=0
SECRET_KEY=replace-with-50-random-chars
ALLOWED_HOSTS=api.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://finance.example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=https://finance.example.com
USE_X_FORWARDED_HOST=1
USE_X_FORWARDED_PROTO=1
# TLS 由前端 Nginx 终止；后端通过 X-Forwarded-Proto 识别 https。
# 若后端也直接暴露 HTTP，请改为 1 并确保所有流量都走 HTTPS。
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# ===== MySQL =====
DB_ENGINE=mysql
DB_NAME=finance
DB_USER=finance_app
DB_PASSWORD=replace-with-strong-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_finance

# ===== AI key encryption =====
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=

# ===== Market data =====
MARKET_DATA_TIMEOUT=30
MARKET_DATA_PROXY=
