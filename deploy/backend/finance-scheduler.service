[Unit]
Description=Finance System Scheduler (APScheduler)
After=network.target mysql.service finance-api.service
Wants=mysql.service

[Service]
Type=simple
User=finance
Group=finance
WorkingDirectory=/opt/finance/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings
EnvironmentFile=-/opt/finance/backend/.env
ExecStart=/opt/finance/venv/bin/python manage.py run_scheduler
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/finance/backend
UMask=0077

[Install]
WantedBy=multi-user.target
